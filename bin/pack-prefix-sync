#!/usr/bin/env python3
# pack-prefix-sync — 묶음 스킬(gstack·superpowers·pstack)을 사람이 부를 때 <팩>-<이름>으로 보이게 맞춘다.
#
# DeepSeek Harness(dsh-sync-skills)와 같은 규칙을 Claude Code(VS Code 확장 포함)와 Codex에 적용한다.
#   사람이 부르는 이름: <팩>-<이름>   (예: /gstack-browse, /superpowers-brainstorming)
#   모델이 부르는 이름: 원래 이름 그대로 둔다(지침·라우터가 원래 이름을 쓴다). 숨김을 지원하지 않는 도구는 말머리 이름 하나만 둔다.
#
# Claude Code (~/.claude/skills, 노출 설정 ~/.claude/settings.json skillOverrides)
#   원래 이름이 user-invocable-only → <팩>-<이름> 감싸개(disable-model-invocation: true)를 만들고 원래 이름은 off
#   원래 이름이 on·name-only·설정 없음 → <팩>-<이름> 감싸개(사람용) + 원래 이름 링크를 모델 전용 감싸개(user-invocable: false)로 바꿈
#   원래 이름이 off이고 말머리 감싸개가 없음 → 손대지 않음
#   이미 <팩>-로 시작하는 이름(gstack-upgrade 등) → 손대지 않음
# Codex (~/.agents/skills를 읽음, 사람·모델 구분 없음)
#   ~/.codex/skills/<팩>-<이름> 감싸개(+ 원본 agents/openai.yaml의 policy)를 만들고,
#   ~/.codex/config.toml의 [[skills.config]]로 원래 이름을 끈다.
# 이 스크립트가 만든 감싸개(MARK 표시)만 고치거나 지운다. 손으로 둔 폴더는 건드리지 않는다.
#
# 사용법:
#   pack-prefix-sync              바꿀 것을 보여 주기만 한다(맞지 않으면 종료 코드 1)
#   pack-prefix-sync --apply      실제로 고친다
#   pack-prefix-sync --only claude|codex
# 설치되지 않은 도구(~/.claude나 ~/.codex가 없음)는 건너뛴다.
import json
import os
import re
import shutil
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'lib'))
import workbench_config  # noqa: E402

HOME = os.path.expanduser('~')
SHELF = workbench_config.shelf()
CLAUDE_SKILLS = os.environ.get('PPS_CLAUDE_SKILLS', os.path.join(HOME, '.claude', 'skills'))
CLAUDE_SETTINGS = os.environ.get('PPS_CLAUDE_SETTINGS', os.path.join(HOME, '.claude', 'settings.json'))
CODEX_SKILLS = os.environ.get('PPS_CODEX_SKILLS', os.path.join(HOME, '.codex', 'skills'))
CODEX_CONFIG = os.environ.get('PPS_CODEX_CONFIG', os.path.join(HOME, '.codex', 'config.toml'))
PACKS = tuple(workbench_config.load()['packs'])
MARK = workbench_config.MARKS['pack-prefix-sync']
CODEX_BLOCK_START = '# pack-prefix-sync: 말머리 감싸개가 대신하는 원래 이름(자동 생성, 손으로 고치지 않음)'
CODEX_BLOCK_END = '# pack-prefix-sync: 끝'
NAME_OK = re.compile(r'^[a-z0-9]+(-[a-z0-9]+)*$')


def pack_name(prefix, name):
    """이름에서 팩 이름을 떼고 맨 앞에 한 번만 붙인다(dsh-sync-skills와 같은 규칙)."""
    base = '-'.join(part for part in name.split('-') if part != prefix)
    return f'{prefix}-{base}' if base else prefix


def frontmatter(path):
    try:
        with open(path, encoding='utf-8') as f:
            text = f.read(20000)
    except OSError:
        return {}
    if not text.startswith('---'):
        return {}
    end = text.find('\n---', 3)
    if end < 0:
        return {}
    lines = text[3:end].strip('\n').split('\n')
    out, i = {}, 0
    while i < len(lines):
        m = re.match(r'^([A-Za-z][\w-]*):\s*(.*)$', lines[i])
        i += 1
        if not m:
            continue
        key, value = m.group(1), m.group(2).strip()
        if value in ('', '|', '>', '|-', '>-', '|+', '>+'):
            block = []
            while i < len(lines) and (lines[i][:1] in (' ', '\t') or lines[i] == ''):
                block.append(lines[i].strip())
                i += 1
            value = ' '.join(b for b in block if b)
        elif len(value) >= 2 and value[0] == value[-1] and value[0] in '"\'':
            value = value[1:-1].replace('\\"', '"') if value[0] == '"' else value[1:-1]
        out[key] = value
    return out


def is_ours(path):
    try:
        with open(os.path.join(path, 'SKILL.md'), encoding='utf-8') as f:
            return MARK in f.read(4000)
    except OSError:
        return False


def pack_of(path):
    """심볼릭 링크·실제 경로로 어느 묶음인지 정한다."""
    seen = {path, os.path.realpath(path)}
    try:
        seen.add(os.readlink(path))
    except OSError:
        pass
    for p in seen:
        for pack in PACKS:
            if f'/{pack}/' in p or f'/skills/{pack}-' in p or f'/{pack}-runtime' in p:
                return pack
        if '/garrytan/gstack/' in p:
            return 'gstack'
    return None


def wrapper(name, real_dir, pack, original, extra):
    meta = frontmatter(os.path.join(real_dir, 'SKILL.md'))
    desc = (meta.get('description') or name).strip()
    if len(desc) > 1000:
        desc = desc[:997].rstrip() + '...'
    lines = ['---', f'name: {name}', f'description: {json.dumps(desc, ensure_ascii=False)}']
    if meta.get('argument-hint'):
        lines.append(f'argument-hint: {json.dumps(meta["argument-hint"], ensure_ascii=False)}')
    lines += extra
    lines += ['---', MARK, '', f'# {name}', '',
              f'(`{pack}` 팩의 `{original}`. 사람이 부르는 이름은 `/{pack_name(pack, original)}`)', '',
              f'1. `{os.path.join(real_dir, "SKILL.md")}`를 끝까지 읽고 그대로 따른다.',
              f'2. 그 안의 상대 경로(`references/`, `scripts/` 등)는 `{real_dir}` 기준으로 찾는다.', '']
    return '\n'.join(lines)


def write_wrapper(path, text, apply, log, extra_files=None):
    target = os.path.join(path, 'SKILL.md')
    try:
        with open(target, encoding='utf-8') as f:
            same = f.read() == text
    except OSError:
        same = False
    if same and not extra_files:
        return 0
    if os.path.lexists(path) and not os.path.isdir(path):
        pass
    elif os.path.isdir(path) and not os.path.islink(path) and not is_ours(path):
        log(f'건너뜀 {path}: 손으로 둔 폴더라 그대로 둡니다')
        return 0
    changes = 0
    if not same:
        log(f'{"갱신" if os.path.exists(target) else "추가"} {path}')
        changes += 1
        if apply:
            if os.path.islink(path):
                os.unlink(path)
            os.makedirs(path, exist_ok=True)
            with open(target, 'w', encoding='utf-8') as f:
                f.write(text)
    for rel, content in (extra_files or {}).items():
        dest = os.path.join(path, rel)
        try:
            with open(dest, encoding='utf-8') as f:
                if f.read() == content:
                    continue
        except OSError:
            pass
        log(f'{"갱신" if os.path.exists(dest) else "추가"} {dest}')
        changes += 1
        if apply:
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            with open(dest, 'w', encoding='utf-8') as f:
                f.write(content)
    return changes


# ---------------------------------------------------------------- Claude Code
def claude(apply, log):
    if not os.path.isdir(CLAUDE_SKILLS):
        log(f'건너뜀: {CLAUDE_SKILLS}가 없습니다(Claude Code 미설치 또는 스킬 없음)')
        return 0
    try:
        with open(CLAUDE_SETTINGS, encoding='utf-8') as f:
            settings = json.load(f)
    except FileNotFoundError:
        settings = {}
    except (OSError, ValueError) as e:
        log(f'Claude 설정을 읽지 못해 멈춤(고친 뒤 다시 실행): {e}')
        return -1
    overrides = settings.setdefault('skillOverrides', {})
    changes, want_human = 0, set()
    for entry in sorted(os.listdir(CLAUDE_SKILLS)):
        path = os.path.join(CLAUDE_SKILLS, entry)
        if entry.startswith('.') or not os.path.isdir(path):
            continue
        ours = is_ours(path)
        if not os.path.islink(path) and not ours:
            continue
        if ours:
            meta = frontmatter(os.path.join(path, 'SKILL.md'))
            if meta.get('disable-model-invocation') == 'true':
                continue  # 사람용 감싸개는 원래 이름 쪽에서 다룬다
            m = re.search(r'`([^`]+)/SKILL\.md`를 끝까지', open(os.path.join(path, 'SKILL.md'), encoding='utf-8').read())
            real_dir = m.group(1) if m else None
        else:
            # 링크가 가리키는 자리(~/.agents/skills/<팩>/…)를 그대로 쓴다. 원본 저장소 위치가 바뀌어도 감싸개가 깨지지 않는다.
            target = os.readlink(path)
            real_dir = os.path.normpath(target if os.path.isabs(target) else os.path.join(CLAUDE_SKILLS, target))
        pack = pack_of(real_dir)
        if pack is None or real_dir is None or not os.path.isfile(os.path.join(real_dir, 'SKILL.md')):
            continue
        if entry.startswith(f'{pack}-') or entry == pack:
            continue  # 이미 말머리로 시작
        human = pack_name(pack, entry)
        human_path = os.path.join(CLAUDE_SKILLS, human)
        state = overrides.get(entry, 'on')
        if ours:
            state = 'model'  # 이미 모델 전용 감싸개로 바뀐 원래 이름
        elif state == 'off' and not is_ours(human_path):
            continue
        want_human.add(human)
        changes += write_wrapper(human_path, wrapper(human, real_dir, pack, entry, ['disable-model-invocation: true']), apply, log)
        if state == 'user-invocable-only' or (state == 'off'):
            if overrides.get(entry) != 'off':
                log(f'설정 {entry}: {overrides.get(entry, "on")} → off (사람은 /{human})')
                overrides[entry] = 'off'
                changes += 1
        else:  # on·name-only·model: 원래 이름은 모델 전용으로
            changes += write_wrapper(path, wrapper(entry, real_dir, pack, entry, ['user-invocable: false']), apply, log)
            if overrides.get(entry) in ('name-only',):
                pass
    for entry in sorted(os.listdir(CLAUDE_SKILLS)):
        path = os.path.join(CLAUDE_SKILLS, entry)
        if is_ours(path) and frontmatter(os.path.join(path, 'SKILL.md')).get('disable-model-invocation') == 'true' and entry not in want_human:
            log(f'제거 {path} (원본이 사라졌거나 꺼짐)')
            changes += 1
            if apply:
                shutil.rmtree(path)
    if apply and changes:
        os.makedirs(os.path.dirname(CLAUDE_SETTINGS), exist_ok=True)
        tmp = CLAUDE_SETTINGS + '.pps-tmp'
        with open(tmp, 'w', encoding='utf-8') as f:
            json.dump(settings, f, ensure_ascii=False, indent=2)
            f.write('\n')
        os.replace(tmp, CLAUDE_SETTINGS)
    return changes


# ---------------------------------------------------------------- Codex
def codex_sources():
    """Codex가 ~/.agents/skills에서 읽는 묶음 스킬: {원래 이름: (팩, 경로)}."""
    out = {}
    for pack in PACKS:
        root = os.path.join(SHELF, pack)
        if not os.path.isdir(root) or os.path.islink(root):
            continue  # Codex는 심볼릭 링크 묶음 폴더(superpowers)를 따라가지 않는다
        for sub in sorted(os.listdir(root)):
            skill_dir = os.path.join(root, sub)
            meta = frontmatter(os.path.join(skill_dir, 'SKILL.md'))
            name = meta.get('name')
            if name and NAME_OK.match(name) and not name.startswith(f'{pack}-'):
                out[name] = (pack, skill_dir)
    return out


def codex_policy(skill_dir, human):
    try:
        with open(os.path.join(skill_dir, 'agents', 'openai.yaml'), encoding='utf-8') as f:
            text = f.read()
    except OSError:
        return None
    text = re.sub(r'(display_name:\s*).*', lambda m: f'{m.group(1)}"{human}"', text, count=1)
    text = re.sub(r'(default_prompt:\s*).*', lambda m: f'{m.group(1)}"Use {human} for this task."', text, count=1)
    return text if text.endswith('\n') else text + '\n'


def codex(apply, log):
    if not workbench_config.codex_present() and 'PPS_CODEX_CONFIG' not in os.environ:
        log(f'건너뜀: {os.path.dirname(CODEX_CONFIG)}에 Codex 설정이 없습니다(Codex 미설치)')
        return 0
    if apply:
        os.makedirs(CODEX_SKILLS, exist_ok=True)
    sources = codex_sources()
    changes, want, disabled = 0, set(), []
    for name, (pack, skill_dir) in sorted(sources.items()):
        human = pack_name(pack, name)
        want.add(human)
        extra = {}
        policy = codex_policy(skill_dir, human)
        if policy:
            extra['agents/openai.yaml'] = policy
        changes += write_wrapper(os.path.join(CODEX_SKILLS, human), wrapper(human, skill_dir, pack, name, []), apply, log, extra)
        disabled.append(os.path.join(skill_dir, 'SKILL.md'))
    for entry in sorted(os.listdir(CODEX_SKILLS)) if os.path.isdir(CODEX_SKILLS) else []:
        path = os.path.join(CODEX_SKILLS, entry)
        if is_ours(path) and entry not in want:
            log(f'제거 {path} (원본이 사라짐)')
            changes += 1
            if apply:
                shutil.rmtree(path)
    block = [CODEX_BLOCK_START]
    for p in disabled:
        block += ['[[skills.config]]', f'path = {json.dumps(p)}', 'enabled = false', '']
    block.append(CODEX_BLOCK_END)
    block_text = '\n'.join(block) + '\n'
    try:
        with open(CODEX_CONFIG, encoding='utf-8') as f:
            config = f.read()
    except FileNotFoundError:
        config = ''
    if not disabled and CODEX_BLOCK_START not in config:
        return changes
    pattern = re.compile(re.escape(CODEX_BLOCK_START) + r'.*?' + re.escape(CODEX_BLOCK_END) + r'\n?', re.S)
    if pattern.search(config):
        new = pattern.sub(lambda _: block_text, config)
    else:
        new = (config.rstrip('\n') + '\n\n' if config.strip() else '') + block_text
    if new != config:
        log(f'설정 {CODEX_CONFIG}: 원래 이름 {len(disabled)}개 끔')
        changes += 1
        if apply:
            tmp = CODEX_CONFIG + '.pps-tmp'
            with open(tmp, 'w', encoding='utf-8') as f:
                f.write(new)
            os.replace(tmp, CODEX_CONFIG)
    return changes


def main():
    args = sys.argv[1:]
    apply = '--apply' in args
    only = args[args.index('--only') + 1] if '--only' in args else None
    total = 0
    for label, fn in (('claude', claude), ('codex', codex)):
        if only and only != label:
            continue
        lines = []
        n = fn(apply, lines.append)
        for line in lines:
            print(f'[{label}] {line}')
        if n < 0:
            return 2
        print(f'[{label}] {"고침" if apply else "바꿀 것"} {n}건' if n else f'[{label}] 바꿀 것 없음')
        total += n
    return 0 if apply or total == 0 else 1


if __name__ == '__main__':
    sys.exit(main())

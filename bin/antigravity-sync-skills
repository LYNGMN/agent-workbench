#!/usr/bin/env python3
# antigravity-sync-skills — 공용 선반(~/.agents/skills)을 Antigravity가 읽는 자리(~/.gemini/config/skills)에 링크로 맞춘다.
#
# Antigravity 2.x는 ~/.gemini/config/skills/<이름>/SKILL.md만 한 단계로 읽는다.
# 그래서 선반의 묶음 폴더(cloudflare/, gstack/gstack-*, superpowers/ …)를 한 단계로 펼쳐 링크한다.
#   ~/.gemini/config/skills/<이름> -> ~/.agents/skills/<묶음>/<폴더>
#   <이름>: SKILL.md frontmatter의 name(소문자·하이픈이 아니면 폴더 이름, gstack-는 뗌)
#   뺀다: config/defaults.json의 antigravity_skip(using-superpowers, codex, 목록 예산 때문에 뺀 스킬)
#   묶음 스킬(gstack·superpowers·pstack)은 <팩>-<이름> 감싸개 폴더로 둔다(DSH·Claude·Codex와 같은 말머리).
#     감싸개는 실제 SKILL.md를 가리키며 MARK 표시가 있는 것만 이 스크립트가 고치거나 지운다.
#   선반·원본을 가리키는 링크 가운데 선반에 없는 이름만 지운다. 다른 곳을 가리키는 링크와 실제 폴더는 건드리지 않는다.
#   Antigravity가 없으면(~/.gemini 없음) 아무것도 하지 않는다.
#   Antigravity는 스킬 목록을 "이름+경로+설명"이 작은 것부터 약 32KB까지만 설명과 함께 넣고
#   나머지는 이름만 남긴다. 그래서 Antigravity에서 쓰지 않는 스킬은 연결하지 않는다.
#   SKILL.md 머리말이 YAML 문법에 어긋나면 알려 준다. Claude는 너그럽게 읽지만
#   Antigravity는 그런 스킬을 목록에서 조용히 뺀다(2026-10-26 ui-visual-qa·ecc).
#
# 사용법:
#   antigravity-sync-skills          바꿀 것을 보여 주기만 한다(맞지 않거나 머리말 오류가 있으면 종료 코드 1)
#   antigravity-sync-skills --apply  실제로 고친다
import json
import os
import re
import shutil
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'lib'))
import workbench_config  # noqa: E402

CONFIG = workbench_config.load()
HOME = os.path.expanduser('~')
SHELF = os.environ.get('AGY_SHELF', workbench_config.shelf())
TARGET = os.environ.get('AGY_SKILLS_DIR', os.path.join(HOME, '.gemini', 'config', 'skills'))
SKILLS_JSON = os.path.join(os.path.dirname(TARGET), 'skills.json')
# Antigravity는 스킬 목록을 약 32KB까지만 설명과 함께 싣는다. 자주 쓰지 않는 스킬은 여기서만 뺀다
# (선반·Claude·Codex에는 그대로 있음). 목록은 config/defaults.json의 antigravity_skip.
SKIP = set(CONFIG['antigravity_skip'])
MANAGED = workbench_config.managed_roots()
NAME_OK = re.compile(r'^[a-z0-9][a-z0-9-]*$')
PACKS = tuple(CONFIG['packs'])
MARK = workbench_config.MARKS['antigravity-sync-skills']


def pack_name(prefix, name):
    """이름에서 팩 이름을 떼고 맨 앞에 한 번만 붙인다(dsh-sync-skills·pack-prefix-sync와 같은 규칙)."""
    base = '-'.join(part for part in name.split('-') if part != prefix)
    return f'{prefix}-{base}' if base else prefix


def front_description(skill_md):
    try:
        with open(skill_md, encoding='utf-8') as f:
            text = f.read(20000)
    except OSError:
        return ''
    m = re.match(r'^---\r?\n(.*?)\r?\n---', text, re.S)
    if not m:
        return ''
    lines = m.group(1).splitlines()
    for i, line in enumerate(lines):
        d = re.match(r'^description:\s*(.*)$', line)
        if not d:
            continue
        value = d.group(1).strip()
        if value in ('', '|', '>', '|-', '>-'):
            block = []
            for nxt in lines[i + 1:]:
                if nxt[:1] not in (' ', '\t') and nxt != '':
                    break
                block.append(nxt.strip())
            return ' '.join(b for b in block if b)
        if len(value) >= 2 and value[0] == value[-1] and value[0] in '"\'':
            value = value[1:-1].replace('\\"', '"') if value[0] == '"' else value[1:-1]
        return value
    return ''


def wrapper_text(name, src, pack, original):
    desc = front_description(os.path.join(src, 'SKILL.md')) or name
    real = os.path.join(src, 'SKILL.md')
    return (
        '---\n'
        f'name: {name}\n'
        f'description: {json.dumps(desc, ensure_ascii=False)}\n'
        '---\n'
        f'{MARK}\n\n'
        f'# {name}\n\n'
        f'(`{pack}` 팩의 `{original}`)\n\n'
        f'1. `{real}`를 끝까지 읽고 그대로 따른다.\n'
        f'2. 그 안의 상대 경로(`references/`, `scripts/` 등)는 `{src}` 기준으로 찾는다.\n'
    )


def is_ours(path):
    try:
        with open(os.path.join(path, 'SKILL.md'), encoding='utf-8') as f:
            return MARK in f.read(4000)
    except OSError:
        return False


def front_name(skill_md):
    try:
        with open(skill_md, encoding='utf-8') as f:
            head = f.read(4000)
    except OSError:
        return None
    if not head.startswith('---'):
        return None
    m = re.search(r'^name:\s*["\']?([^"\'\n]+)', head, re.M)
    return m.group(1).strip() if m else None


PLAIN_START_BAD = re.compile(r'^([@`%!&*?,|>]|- )')


def front_matter_problems(skill_md):
    """따옴표 없는 YAML 값에서 자주 나는 문법 오류를 찾는다. 문제 설명 목록을 돌려준다."""
    try:
        with open(skill_md, encoding='utf-8') as f:
            text = f.read()
    except OSError as e:
        return [f'읽지 못함({e.strerror})']
    m = re.match(r'^---\r?\n(.*?)\r?\n---\r?\n', text, re.S)
    if not m:
        return ['머리말(--- … ---)이 없음']
    problems, keys, plain_key = [], set(), None
    for line in m.group(1).splitlines():
        top = re.match(r'^([A-Za-z_][\w-]*):(?:\s+(.*))?$', line)
        if top:
            key, value = top.group(1), (top.group(2) or '').rstrip()
            keys.add(key)
            plain_key = None
            if not value or value[0] in '"\'|>[{':
                continue
            plain_key = key
            if PLAIN_START_BAD.match(value):
                problems.append(f'{key}: 따옴표 없는 값이 특수문자로 시작')
            chunk = value
        elif plain_key and line[:1] in (' ', '\t'):
            chunk = line.strip()  # 따옴표 없는 값이 다음 줄로 이어짐
        else:
            plain_key = None
            continue
        if ': ' in chunk or chunk.endswith(':'):
            problems.append(f"{plain_key}: 따옴표 없는 값 안에 ': '")
        if ' #' in chunk:
            problems.append(f"{plain_key}: 따옴표 없는 값 안에 ' #'(주석으로 잘림)")
    for need in ('name', 'description'):
        if need not in keys:
            problems.append(f'{need} 없음')
    return sorted(set(problems))


def link_name(folder, skill_md):
    name = front_name(skill_md)
    if name and NAME_OK.match(name):
        return name
    return folder[len('gstack-'):] if folder.startswith('gstack-') else folder


def wanted():
    """선반을 펼쳐 {링크 이름: 선반 안 경로}를 만든다. 같은 이름이 두 번 나오면 먼저 나온 것을 쓴다."""
    out, dupes = {}, []
    for entry in sorted(os.listdir(SHELF)):
        if entry.startswith('.'):
            continue
        path = os.path.join(SHELF, entry)
        if os.path.isfile(os.path.join(path, 'SKILL.md')):
            found = [(entry, path)]
        elif os.path.isdir(path):
            found = [(sub, os.path.join(path, sub)) for sub in sorted(os.listdir(path))
                     if os.path.isfile(os.path.join(path, sub, 'SKILL.md'))]
        else:
            continue
        pack = entry if entry in PACKS and len(found) > 0 and found[0][1] != path else None
        for folder, skill_dir in found:
            name = link_name(folder, os.path.join(skill_dir, 'SKILL.md'))
            if name in SKIP:
                continue
            original = name
            if pack and not (name == pack or name.startswith(f'{pack}-')):
                name = pack_name(pack, name)
            if name in out:
                dupes.append((name, skill_dir))
                continue
            out[name] = skill_dir
            if pack:
                PACKED[name] = (pack, original)
    return out, dupes


PACKED = {}  # 말머리 감싸개로 둘 이름: (팩, 원래 이름)


def main():
    apply = '--apply' in sys.argv[1:]
    if not os.path.isdir(os.path.join(HOME, '.gemini')) and 'AGY_SKILLS_DIR' not in os.environ:
        print('건너뜀: ~/.gemini가 없습니다(Antigravity 미설치)')
        return 0
    if not os.path.isdir(SHELF):
        print(f'공용 선반이 없습니다: {SHELF}', file=sys.stderr)
        return 2
    if apply:
        os.makedirs(TARGET, exist_ok=True)
    want, dupes = wanted()
    changes = 0

    def act(message, fn):
        nonlocal changes
        changes += 1
        print(message)
        if apply:
            fn()

    # 1) 선반에 있는 스킬을 잇는다. 이미 같은 곳을 가리키면 그대로 둔다.
    for name, src in sorted(want.items()):
        dest = os.path.join(TARGET, name)
        if name in PACKED and name != PACKED[name][1]:
            text = wrapper_text(name, src, *PACKED[name])
            md = os.path.join(dest, 'SKILL.md')
            if os.path.isdir(dest) and not os.path.islink(dest) and not is_ours(dest):
                print(f'건너뜀 {name}: 손으로 둔 실제 폴더라 그대로 둡니다')
                continue
            try:
                with open(md, encoding='utf-8') as f:
                    if not os.path.islink(dest) and f.read() == text:
                        continue
            except OSError:
                pass

            def put(d=dest, m=md, t=text):
                if os.path.islink(d):
                    os.unlink(d)
                os.makedirs(d, exist_ok=True)
                with open(m, 'w', encoding='utf-8') as f:
                    f.write(t)
            act(f'감싸개 {name} -> {src}', put)
            continue
        if os.path.islink(dest):
            if os.path.realpath(dest) == os.path.realpath(src):
                continue
            act(f'교체 {name} -> {src}', lambda d=dest, s=src: (os.unlink(d), os.symlink(s, d)))
        elif os.path.exists(dest):
            print(f'건너뜀 {name}: 링크가 아닌 실제 폴더라 그대로 둡니다')
        else:
            act(f'추가 {name} -> {src}', lambda d=dest, s=src: os.symlink(s, d))

    # 2) 선반에 없는 이름의 링크를 지운다(실제 폴더는 두고 알려만 준다).
    for name in sorted(os.listdir(TARGET)) if os.path.isdir(TARGET) else []:
        dest = os.path.join(TARGET, name)
        if name in want or name.startswith('.'):
            continue
        if os.path.islink(dest) and not workbench_config.points_inside(dest, MANAGED):
            print(f'확인 필요 {name}: 선반 밖을 가리키는 링크입니다(지우지 않음)')
        elif os.path.islink(dest):
            act(f'제거 {name} (선반에 없음 또는 제외 대상)', lambda d=dest: os.unlink(d))
        elif is_ours(dest):
            act(f'제거 {name} (말머리 감싸개, 원본이 사라짐)', lambda d=dest: shutil.rmtree(d))
        elif os.path.isdir(dest):
            print(f'확인 필요 {name}: 선반에 없는 실제 폴더입니다(지우지 않음)')

    for name, src in dupes:
        print(f'같은 이름 무시 {name}: {src}')

    # 3) 전역 skills.json에 경로가 남아 있으면 같은 스킬이 두 번 등록되므로 알려 준다.
    try:
        with open(SKILLS_JSON, encoding='utf-8') as f:
            if json.load(f).get('entries'):
                print(f'주의: {SKILLS_JSON}에 entries가 남아 있어 스킬이 중복 등록됩니다')
    except (OSError, ValueError):
        pass

    # 4) 머리말 문법. 고칠 곳은 링크가 아니라 선반의 원본 SKILL.md다.
    bad_front = 0
    for name, src in sorted(want.items()):
        problems = front_matter_problems(os.path.join(src, 'SKILL.md'))
        if problems:
            bad_front += 1
            print(f'머리말 오류 {name}: {", ".join(problems)} — Antigravity가 이 스킬을 빼거나 설명을 잘라 읽습니다. '
                  f'따옴표 없는 값은 큰따옴표로 감싸고, 빠진 항목은 채우세요 ({os.path.realpath(src)}/SKILL.md)')

    broken = [n for n in (os.listdir(TARGET) if os.path.isdir(TARGET) else []) if os.path.islink(os.path.join(TARGET, n))
              and not os.path.exists(os.path.join(TARGET, n))]
    total = len(want)
    if changes == 0:
        print(f'바꿀 것 없음 (스킬 {total}개, 깨진 링크 {len(broken)}개, 머리말 오류 {bad_front}개)')
        return 1 if bad_front else 0
    if apply:
        print(f'{changes}건 고침 (스킬 {total}개, 머리말 오류 {bad_front}개)')
        return 1 if bad_front else 0
    print(f'{changes}건 바꿀 것 있음 — 고치려면 --apply (머리말 오류 {bad_front}개)')
    return 1


if __name__ == '__main__':
    sys.exit(main())
